+
+// Classification is captured at the actual outbound, independent of node names
+// and subsequent selector changes. Groups preserve the underlying connection.
+func isProxyOutbound(kind C.AdapterType) bool {
+	switch kind {
+	case C.Direct, C.Reject, C.RejectDrop, C.Compatible, C.Pass, C.PassRule, C.Rematch, C.Dns:
+		return false
+	default:
+		return true
+	}
+}
+
+func (c *conn) IsProxy() bool       { return c.proxy }
+func (c *packetConn) IsProxy() bool { return c.proxy }
